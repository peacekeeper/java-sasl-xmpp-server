admins = [
    'admin@java-sasl-xmpp-server'
]
'config-type' = 'default'
debug = [ 'server' ]
'default-virtual-host' = 'java-sasl-xmpp-server'
dataSource () {
    default () {
        uri = 'jdbc:postgresql://tigasedb/tigasedb?user=tigase_user&password=tigase_pass'
    }
}
ext () {}
'ext-man' () {}
http () {
    setup () {
        'admin-password' = 'setuppassword'
        'admin-user' = 'setupusername'
    }
}
pubsub () {
    trusted = [ 'http@{clusterNode}' ]
}
'sess-man' () {
    'jabber:iq:last-marker' () {}
    motd () {}
    'sasl-provider' () {
        customSaslFactory(class: sasl.mechanism.did.server.DIDChallengeSaslServerFactory) {}
        callback-handler-factory(class: sasl.xmpp.server.SaslServerCallbackHandler) {}
        'mechanism-selector'(class: sasl.xmpp.server.SaslServerMechanismSelector) {}
    }
}
