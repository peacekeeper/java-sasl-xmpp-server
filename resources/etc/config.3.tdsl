admins = [ 'admin@java-sasl-xmpp-server' ]
'config-type' = 'default'
debug = [ 'server' ]
'default-virtual-host' = 'java-sasl-xmpp-server'
dataSource () {
    default () {
        uri = 'jdbc:postgresql://tigasedb/tigasedb?user=tigase_user&password=tigase_pass'
    }
}
bosh (active: false) {
    seeOtherHost {}
}
c2s {
    # Enable Stream Management bean
    'urn:xmpp:sm:3' () {}

    # Register tigase.server.xmppclient.SeeOtherHostDualIP as seeOtherHost bean
    seeOtherHost (class: tigase.server.xmppclient.SeeOtherHostDualIP) {}

    # Add additional port 5224 which is SSL port and disable port 5223
    connections () {
        '5224' () {
             socket = ssl
          }
        '5223' (active: false) {}
    }
}
http () {
    setup () {
        'admin-password' = 'tigase'
        'admin-user' = 'admin'
    }
}
'message-archive' (active: false) {}
mix (active: false) {}
muc (active: false) {}
pubsub (active: false) {
    trusted = [ 'http@{clusterNode}' ]
}
s2s (active: false) {}
upload (active: false) {}
ws2s (active: false) {
    seeOtherHost {}
}
